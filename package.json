{
	"name": "@hyvmind/tiktoken-ts",
	"version": "0.1.0",
	"packageManager": "pnpm@10.28.0",
	"sideEffects": false,
	"description": "A pure TypeScript implementation of OpenAI's tiktoken tokenizer, compatible with tiktoken-rs",
	"author": "Evandro Camargo",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./encodings": {
			"import": "./dist/encodings/index.js",
			"types": "./dist/encodings/index.d.ts"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"tiktoken",
		"tokenizer",
		"bpe",
		"openai",
		"gpt",
		"gpt-4",
		"gpt-4o",
		"claude",
		"llm",
		"tokens",
		"encoding"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hyvmind-io/tiktoken-ts.git"
	},
	"bugs": {
		"url": "https://github.com/hyvmind-io/tiktoken-ts/issues"
	},
	"homepage": "https://github.com/hyvmind-io/tiktoken-ts#readme",
	"engines": {
		"node": ">=18.0.0"
	},
	"scripts": {
		"clean": "rm -rf dist",
		"prebuild": "pnpm run clean",
		"build": "tsc",
		"dev": "tsc --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "eslint src --ext .ts",
		"lint:fix": "eslint src --ext .ts --fix",
		"format": "prettier --write \"src/**/*.ts\"",
		"format:check": "prettier --check \"src/**/*.ts\"",
		"prepublishOnly": "tsc"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.2",
		"@types/node": "^22.0.0",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"@vitest/coverage-v8": "^2.0.0",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "^9.0.0",
		"prettier": "^3.0.0",
		"typescript": "^5.6.0",
		"typescript-eslint": "^8.54.0",
		"vitest": "^2.0.0"
	}
}
